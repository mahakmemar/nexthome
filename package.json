{
  "name": "testproj",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "tsx prisma/seed.ts",
    "seed:demo": "tsx prisma/seed-demo.ts",
    "sim:db": "DATABASE_URL=file:./simulate.db prisma db push",
    "dev:simulate": "npm run sim:db && SIMULATE=1 DATABASE_URL=file:./simulate.db NEXT_DIST_DIR=.next-sim next dev -p 3000",
    "build:simulate": "NEXT_DIST_DIR=.next-sim next build",
    "start:simulate": "npm run sim:db && SIMULATE=1 DATABASE_URL=file:./simulate.db NEXT_DIST_DIR=.next-sim next start -p 3000",
    "test:e2e": "playwright test",
    "test:e2e:normal": "playwright test -c playwright.normal.config.ts",
    "test:e2e:guard": "node e2e-normal/check-sim-guard.mjs",
    "test:e2e:all": "playwright test && npm run test:e2e:guard && npm run test:e2e:normal"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "next": "16.3.0",
    "prisma": "^7.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.9.1": true,
    "unrs-resolver@1.12.2": true,
    "better-sqlite3@12.11.1": true,
    "fsevents@2.3.3": true
  }
}
