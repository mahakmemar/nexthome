# Copy to .env and adjust
DATABASE_URL="file:./dev.db"

# Signs login session cookies. Generate your own with: openssl rand -hex 32
SESSION_SECRET=""

# The public address of this app (used for the Google / Facebook sign-in callbacks).
APP_URL="http://localhost:3000"

# "Continue with Google / Facebook" (optional). Create these yourself:
#  - Google: https://console.cloud.google.com/apis/credentials -> OAuth client ID, type "Web application"
#      Authorized redirect URI: http://localhost:3000/api/auth/google/callback
#  - Facebook: https://developers.facebook.com/apps -> add "Facebook Login"
#      Valid OAuth redirect URI: http://localhost:3000/api/auth/facebook/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
